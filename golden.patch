-            self.inner.writer.write_all(&vec![b' '; self.indent])?;
-            self.previous_was_block = true;
-        }
-
-        self.inner.end_elem(name)
-    }
-
-    fn write_text(&mut self, text: &str) -> io::Result<()> {
