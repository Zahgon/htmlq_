+"""The shared behavioural corpus for the Rust/Python parity fixtures.
+
+Each case is `(name, argv, stdin)`. `tools/capture_oracle.py` runs the corpus
+against the original Rust binary and records stdout/stderr/exit status into
+`tests/oracle.json`; `tests/test_parity.py` replays the same corpus against this
+port and asserts the recordings match byte for byte.
+
+Keeping the corpus in one place means a case added here is automatically both
+recorded and checked.
+"""
+
+CASES = [
+    # -- the three cases migrated from tests/cli.rs ------------------------
+    (
+        "find_by_class",
+        [".hi"],
+        '<html><head></head><body><div class="hi"><a href="/foo/bar">Hello</a></div></body></html>',
+    ),
+    (
+        "find_by_id",
+        ["#my-id"],
+        '<html><head></head><body><div id="my-id"><a href="/foo/bar">Hello</a></div></body></html>',
+    ),
+    (
+        "remove_links",
+        ["#my-id", "--remove-nodes", "a"],
+        '<html><head></head><body><div id="my-id"><a href="/foo/bar">Hello</a></div></body></html>',
+    ),
+    # -- defaults and the whole-document path -----------------------------
+    ("default_selector", [], "<p>hello</p>"),
+    ("explicit_html", ["html"], "<p>hello</p>"),
+    ("doctype_is_not_selected", [], "<!DOCTYPE html><p>hi</p>"),
+    ("no_match_prints_nothing", [".nope"], "<p>hi</p>"),
+    ("empty_input", [], ""),
+    (
+        "multiple_matches_each_on_own_line",
+        ["li"],
+        "<ul><li>one</li><li>two</li><li>three</li></ul>",
+    ),
+    # -- serializer edge cases --------------------------------------------
+    ("void_element_roundtrip", ["head"], '<head><link  href="/s.css" rel="stylesheet"/></head>'),
+    ("attribute_order_is_source_order", ["a"], '<a z="1" m="2" a="3" href="/x">t</a>'),
+    ("attribute_escaping", ["a"], '<a title=\'q"&amp;&lt;&gt;\'>t</a>'),
+    ("text_escaping", ["p"], "<p>a &amp; b &lt; c &gt; d</p>"),
